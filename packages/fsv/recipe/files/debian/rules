#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk

%:
	dh $@ --buildsystem=meson

# The source uses empty parameter lists for typed callbacks, which C23
# (the default from GCC 15) rejects as incompatible pointer types.
override_dh_auto_configure:
	dh_auto_configure -- -Dc_std=gnu17

override_dh_auto_install:
	install -Dm755 obj-$(DEB_HOST_GNU_TYPE)/src/fsv \
	  $(CURDIR)/debian/fsv/usr/bin/fsv
