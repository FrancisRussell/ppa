#!/bin/sh
set -e
case "$1" in
  configure)
    if ! getent passwd postfix-ratelimitd > /dev/null; then
      adduser --system --group --home /nonexistent --no-create-home \
              --shell /usr/sbin/nologin postfix-ratelimitd
    fi
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
      if [ -n "$2" ] && systemctl is-active --quiet postfix-ratelimitd; then
        systemctl restart postfix-ratelimitd
      fi
    fi
    ;;
esac
