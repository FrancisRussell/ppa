#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_clean:

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	install -d debian/postfix-ratelimitd/usr/bin
	install -d debian/postfix-ratelimitd/usr/lib/systemd/system
	install -d debian/postfix-ratelimitd/etc/postfix-ratelimitd

	install -m 755 target/release/postfix-ratelimitd debian/postfix-ratelimitd/usr/bin/postfix-ratelimitd
	install -m 644 debian/postfix-ratelimitd.service  debian/postfix-ratelimitd/usr/lib/systemd/system/postfix-ratelimitd.service
	install -m 644 debian/config.toml                 debian/postfix-ratelimitd/etc/postfix-ratelimitd/config.toml
