/* SQL/postgres/2022100100.sql */
CREATE TABLE "uploads" (
    upload_id varchar(64) PRIMARY KEY,
    session_id varchar(128) NOT NULL,
    "group" varchar(128) NOT NULL,
    metadata text NOT NULL,
    created timestamp with time zone DEFAULT now() NOT NULL
);

CREATE INDEX uploads_session_id_idx ON uploads (session_id, "group", created);

/* SQL/postgres/2025092300.sql */
ALTER TABLE "session" RENAME COLUMN changed TO expires_at;
ALTER INDEX "session_changed_idx" RENAME TO "session_expires_at_idx";
UPDATE "session" SET expires_at = expires_at + INTERVAL '10 minutes';

/* update "system" table */
UPDATE "system" SET "value" = '2025092300' WHERE "name" = 'roundcube-version';
