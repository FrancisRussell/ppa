# TinyCME Language Packages have long lines but remain the preferred form of modification,
# see https://www.tiny.cloud/get-tiny/language-packages/
source-is-missing [tinymce-langs/*.js]
source-contains-prebuilt-javascript-object [tinymce-langs/*.js]
very-long-line-length-in-source-file * > 512 [tinymce-langs/*.js:*]

